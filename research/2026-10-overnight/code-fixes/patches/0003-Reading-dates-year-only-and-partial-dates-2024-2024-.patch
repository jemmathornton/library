diff --git a/site/js/app.js b/site/js/app.js
index 2f402e3..641c6b8 100644
--- a/site/js/app.js
+++ b/site/js/app.js
@@ -331,12 +331,13 @@ function readingPanel(b){
 }
 
 const MON = MONTHS.map(m => m.slice(0, 3));
-function dateRange([a, b]){   // ['2024-01-02', '2024-01-20'] -> '2 Jan – 20 Jan 2024'
-  const p = d => (/^(\d{4})-(\d{2})-(\d{2})/.exec(d || "") || []).slice(1).map(Number);
+function dateRange([a, b]){   // ['2024-01-02', '2024-01-20'] -> '2 Jan – 20 Jan 2024'; partial dates too ('2024', '2024-09')
+  const p = d => (/^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?/.exec(d || "") || []).slice(1).map(x => +x || 0);
   const [y1, m1, d1] = p(a), [y2, m2, d2] = p(b);
-  if (!y2) return y1 ? `Started ${d1} ${MON[m1 - 1]} ${y1}` : "";
-  if (!y1 || a === b) return `${d2} ${MON[m2 - 1]} ${y2}`;
-  return `${d1} ${MON[m1 - 1]}${y1 !== y2 ? " " + y1 : ""} – ${d2} ${MON[m2 - 1]} ${y2}`;
+  const when = (y, m, d, withYear = true) => [d || "", m ? MON[m - 1] : "", withYear ? y : ""].filter(Boolean).join(" ");
+  if (!y2) return y1 ? `Started ${when(y1, m1, d1)}` : "";
+  if (!y1 || a === b) return when(y2, m2, d2);
+  return `${when(y1, m1, d1, y1 !== y2 || !m1)} – ${when(y2, m2, d2)}`;
 }
 const starsShown = r => `<span class="sg-stars" style="--r:${(r / 5 * 100).toFixed(1)}%" aria-label="${r} stars"><span>★★★★★</span><span aria-hidden="true">★★★★★</span></span><b class="sg-num">${r}</b>`;
 // her StoryGraph reviews: spoilers stay hidden until clicked
diff --git a/tools/import_storygraph.py b/tools/import_storygraph.py
index 2b327f2..e377c87 100644
--- a/tools/import_storygraph.py
+++ b/tools/import_storygraph.py
@@ -81,15 +81,18 @@ def col(row, *names):
 
 
 def dates_read(s):
-    """'2024/01/02-2024/01/20, 2025/03/01-' -> [['2024-01-02', '2024-01-20'], ['2025-03-01', '']]
-    (splitting on the first '-' works because StoryGraph writes dates with '/')."""
+    """'2024/01/02-2024/01/20, 2025/03/01-' -> [['2024-01-02', '2024-01-20'], ['2025-03-01', '']]. Dates can be partial
+    ('2024-2024', '2024/04/29-2024/09'); a date on its own ('2014/01/08') is when she finished."""
+    d = r'\d{4}(?:/\d{1,2}){0,2}'
+    tidy = lambda x: '-'.join(n.zfill(2) for n in x.strip().split('/')) if x and x.strip() else ''
     out = []
     for part in re.split(r',\s*', s or ''):
         part = part.strip()
         if not part:
             continue
-        ends = [d.strip().replace('/', '-') for d in part.split('-', 1)] if re.match(r'^\d{4}/', part) else [part, '']
-        out.append((ends + [''])[:2])
+        m = re.fullmatch(rf'({d})?\s*-\s*({d})?', part)
+        ends = [tidy(m[1]), tidy(m[2])] if m else ['', tidy(part)] if re.fullmatch(d, part) else [part, '']
+        out.append(ends)
     return out
 
 
